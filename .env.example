# Database
DATABASE_URL=postgresql://genesis:genesis_secret@localhost:5432/genesis

# Redis
REDIS_URL=redis://localhost:6379

# LLM Provider & Model Configuration
# Supported providers: anthropic, openai, ollama, huggingface
LLM_PROVIDER=anthropic
# Prefer the alias (auto-rolls to current production snapshot) over a
# dated identifier like claude-haiku-4-5-20251001 — Anthropic deprecates
# dated snapshots on a rolling schedule; LLMFactory warns when one is in use.
LLM_MODEL=claude-haiku-4-5

# API Keys (provide only the key for your chosen provider)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Ollama (local open-source models)
OLLAMA_BASE_URL=http://localhost:11434

# Auth
# In NODE_ENV=production the API refuses to start unless JWT_SECRET is set,
# is not the placeholder above, AND is at least 32 chars. Generate one with:
#   npm run --workspace=@genesis/api generate:jwt-secret
JWT_SECRET=change_this_to_a_long_random_secret_32_chars_minimum
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowlist) — required in production
ALLOWED_ORIGINS=http://localhost:3000

# Server
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# Simulation
SIMULATION_TICK_INTERVAL_MS=5000
WORLD_SIZE=50
INITIAL_AGENTS=8
OPTIMIZE_PROMPTS=true

# World ID (set after npm run db:seed)
WORLD_ID=
NEXT_PUBLIC_WORLD_ID=
