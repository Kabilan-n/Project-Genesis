# Database
DATABASE_URL=postgresql://genesis:genesis_secret@localhost:5432/genesis

# Redis
REDIS_URL=redis://localhost:6379

# LLM Provider & Model Configuration
# Supported providers: anthropic, openai, ollama, huggingface
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# API Keys (provide only the key for your chosen provider)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Ollama (local open-source models)
OLLAMA_BASE_URL=http://localhost:11434

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# Simulation
SIMULATION_TICK_INTERVAL_MS=5000
WORLD_SIZE=50
INITIAL_AGENTS=8
OPTIMIZE_PROMPTS=true

# World ID (set after npm run db:seed)
WORLD_ID=
NEXT_PUBLIC_WORLD_ID=
